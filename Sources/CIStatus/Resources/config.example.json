{
  "pollIntervalSeconds": 60,

  "tokens": {
    "github": true,
    "vercel": true,
    "sentry": true
  },

  "services": {
    "github": [
      { "owner": "your-org", "repo": "api", "branches": ["main"] },
      { "owner": "your-org", "repo": "web", "branches": ["main", "develop"] }
    ],

    "vercel": [
      {
        "projectId": "prj_YOUR_PROJECT_ID",
        "name": "web",
        "teamId": "team_YOUR_TEAM_ID",
        "branches": ["main"]
      }
    ],

    "sentry": [
      { "org": "your-org", "project": "web", "newWithinHours": 24 }
    ]
  }
}